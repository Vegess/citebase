# Copy this to .env and fill in real values. NEVER commit .env to git.

# LLM provider
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic
ANTHROPIC_API_KEY=

# Database (SQLite)
DATABASE_URL=sqlite:///./documind.db

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLAUDE_MODEL=claude-sonnet-4-6
MAX_UPLOAD_MB=20
RETRIEVAL_TOP_K=3
MAX_PRIOR_TURNS=2
MAX_CONTEXT_CHARS=8000
DAILY_QUESTION_CAP=70
PER_ORG_DAILY_CAP=50
PER_USER_DAILY_CAP=10
MAX_DOCUMENT_CHARS=200000

# Background jobs: thread (default) | inline | off
WORKER_MODE=thread

# Observability: JSON logs, and the bearer token Vigil uses for GET /metrics
LOG_JSON=true
METRICS_TOKEN=
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173